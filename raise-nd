if>\n            <span style=\"font-size:14px;line-height:1.5;color:#FFFFFF;text-wrap:pretty\">{{ why.body }}<\u002Fspan>\n            <div style=\"display:flex;flex-direction:column;gap:6px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.15)\">\n              <span style=\"font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.12em;color:#9AA3AE\">CURRENT DRIVERS<\u002Fspan>\n              <sc-for list=\"{{ why.drivers }}\" as=\"d\"><span style=\"display:flex;justify-content:space-between;gap:10px;font-size:12.5px;color:#FFFFFF\"><span>{{ d.label }}<\u002Fspan><span style=\"color:#C99700;font-family:'IBM Plex Mono',monospace;font-size:11px\">{{ d.dir }}<\u002Fspan><\u002Fspan><\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <span style=\"padding-top:10px;font-size:11px;line-height:1.4;color:#707780\">There is no universally correct option. Changing priorities changes which strategy performs better.<\u002Fspan>\n      <\u002Fsection>\n\n      <section style=\"padding:18px 24px 26px;display:flex;flex-direction:column;gap:12px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#707780\">FUTURE RESEARCH CAPACITY<\u002Fspan><span style=\"padding:2px 6px;border:1px solid #9AA3AE;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.1em;color:#707780\">ILLUSTRATIVE<\u002Fspan><\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:{{ fut.cols }};gap:6px\">\n          <sc-for list=\"{{ fut.parts }}\" as=\"fp\" hint-placeholder-count=\"3\">\n            <div style=\"display:flex;flex-direction:column;gap:8px;min-width:0\">\n              <div style=\"border:1px {{ fp.bs }} {{ fp.bd }};padding:6px;display:grid;grid-template-columns:repeat({{ fp.colsN }},1fr);gap:3px;min-height:70px;align-content:start;background:{{ fp.bg }}\">\n                <sc