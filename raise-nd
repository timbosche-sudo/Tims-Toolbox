8px;border-left:1px solid #E9EBED;display:flex;flex-direction:column;gap:8px\">\n              <span style=\"display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:{{ sc.fg }}\"><span style=\"width:10px;height:10px;background:{{ sc.dot }}\"><\u002Fspan>{{ sc.level }}<\u002Fspan>\n              <span style=\"font-size:13px;line-height:1.45;color:#202832\">{{ sc.reason }}<\u002Fspan>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n\n    <div style=\"display:flex;flex-direction:column;gap:14px\">\n      <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#707780\">QUESTIONS THIS SCENARIO RAISES<\u002Fspan>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px\">\n        <sc-for list=\"{{ cmp }}\" as=\"c\" hint-placeholder-count=\"3\">\n          <div style=\"background:#FFFFFF;border:1px solid #E9EBED;padding:20px 22px;display:flex;flex-direction:column;gap:12px\">\n            <span style=\"font-size:15px;font-weight:600;color:#0C2340\">{{ c.letter }} · {{ c.name }}<\u002Fspan>\n            <sc-for list=\"{{ c.qs }}\" as=\"q\"><span style=\"display:grid;grid-template-columns:18px minmax(0,1fr);gap:8px;font-size:14px;line-height:1.45;color:#202832\"><span style=\"color:#C99700;font-weight:600\">?<\u002Fspan><span>{{ q }}<\u002Fspan><\u002Fspan><\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n      <span style=\"font-size:14px;color:#0C2340;font-weight:500\">The tool should create better questions, not simply outputs.<\u002Fspan>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ vPhasing }}\" hint-placeholder-val=\"{{ false }}\">\n<div data-screen-label=\"04 Galvin Phasing\" style=\"flex:1;min-height:0;overflow-y:auto;zoom:{{ presZoom }}\">\n  <div style=\"max-width:1640px;margin:0 auto;padding:36px 40px 60px;display:flex;flex-direction:column;gap:26px\">\n    <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap\">\n      <div style=\"display:flex;flex-direction:column;gap:10px\">\n        <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#707780\">GALVIN PHASING · SCENARIO {{ activeLetter }} · {{ activeName }}<\u002Fspan>\n        <h2 style=\"margin:0;font-size:40px;font-weight:300;letter-spacing:-0.02em;color:#0C2340;max-width:900px;line-height:1.1\">Protect the research <span style=\"font-weight:600\">while transforming the building.<\u002Fspan><\u002Fh2>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(4,auto);background:#F1F2F3;padding:3px;gap:3px\">\n        <sc-for list=\"{{ phStrat }}\" as=\"o\" hint-placeholder-count=\"4\"><button sc-camel-on-click=\"{{ o.onClick }}\" style=\"min-height:44px;padding:0 14px;background:{{ o.bg }};color:{{ o.fg }};border:none;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.08em;cursor:pointer\">{{ o.label }}<\u002Fbutton><\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"background:#0C2340;padding:28px 32px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap\">\n      <span style=\"font-size:clamp(22px,2.2vw,34px);font-weight:600;letter-spacing:0.01em;line-height:1.2;text-transform:uppercase;color:#FFFFFF;max-width:1100px;text-wrap:balance\">The phasing strategy is a <span style=\"color:#C99700\">research-continuity strategy.<\u002Fspan><\u002Fspan>\n      <button sc-camel-on-click=\"{{ toggleConseq }}\" style=\"flex:none;min-height:52px;padding:0 22px;background:{{ cqBg }};color:{{ cqFg }};border:1px solid #C99700;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;cursor:pointer;transition:all 250ms\">{{ cqLabel }}<\u002Fbutton>\n    <\u002Fdiv>\n    <sc-if value=\"{{ cqOn }}\" hint-placeholder