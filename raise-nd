aceholder-count=\"6\">\n        <div style=\"display:grid;grid-template-columns:{{ phCols }};gap:3px;align-items:center;min-height:34px\">\n          <span style=\"grid-column:1;grid-row:1;display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#202832\"><span style=\"width:8px;height:8px;background:{{ pr.dot }}\"><\u002Fspan>{{ pr.label }}<\u002Fspan>\n          <sc-for list=\"{{ pr.bars }}\" as=\"br\">\n            <span style=\"grid-column:{{ br.gc }};grid-row:1;height:28px;display:flex;align-items:center;padding:0 8px;background:{{ br.bg }};color:{{ br.fg }};border:1px {{ br.bs }} {{ br.bd }};font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.04em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">{{ br.text }}<\u002Fspan>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ vValidate }}\" hint-placeholder-val=\"{{ false }}\">\n<div data-screen-label=\"05 Validate\" style=\"flex:1;min-height:0;overflow-y:auto;zoom:{{ presZoom }}\">\n  <div style=\"max-width:1640px;margin:0 auto;padding:36px 40px 60px;display:flex;flex-direction:column;gap:32px\">\n    <div style=\"display:flex;flex-direction:column;gap:10px\">\n      <span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#707780\">PROJECT BASELINE<\u002Fspan>\n      <h2 style=\"margin:0;font-size:40px;font-weight:300;letter-spacing:-0.02em;color:#0C2340;max-width:1000px;line-height:1.12\">Experience gives us hypotheses. <span style=\"font-weight:600\">It does not give us permission to skip validation.<\u002Fspan><\u002Fh2>\n    <\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px\">\n      <div style=\"background:#FFFFFF;border:1px solid #0C2340;border-top:5px solid #0C2340;padding:22px;display:flex;flex-direction:column;gap:14px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:18px;font-weight:600;color:#0C2340\">What We Know<\u002Fspan><span style=\"padding:3px 8px;background:#0C2340;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:#FFFFFF\">KNOWN<\u002Fspan><\u002Fdiv>\n        <span style=\"font-size:13px;color:#202832\">Facts provided by Notre Dame.<\u002Fspan>\n        <sc-for list=\"{{ known }}\" as=\"k\" hint-placeholder-count=\"8\"><div style=\"display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-top:1px solid #F1F2F3;font-size:14px\"><span style=\"display:flex;flex-direction:column;gap:2px\"><span style=\"color:#202832\">{{ k.a }}<\u002Fspan><span style=\"font-size:11px;color:#707780\">Source: Notre Dame RFP<\u002Fspan><\u002Fspan><span style=\"font-weight:600;color:#0C2340;text-align:right\">{{ k.b }}<\u002Fspan><\u002Fdiv><\u002Fsc-for>\n      <\u002Fdiv>\n      <div style=\"background:#FBFBFA;border:1px dashed #9AA3AE;border-top:3px dashed #707780;padding:22px;display:flex;flex-direction:column;gap:14px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:18px;font-weight:600;color:#0C2340\">What We Believe<\u002Fspan><span style=\"padding:2px 8px;border:1px dashed #707780;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:#202832\">HYPOTHESIS<\u002Fspan><\u002Fdiv>\n        <span style=\"font-size:13px;color:#202832\">Planning hypotheses based on experience.<\u002Fspan>\n        <sc-for list=\"{{ believe }}\" as=\"b\" hint-placeholder-count=\"4\"><div style=\"padding:11px 0;border-top:1px dashed #D5D7DA;font-size:14px;line-height:1.45;color:#202832;font-style:italic\">{{ b }}<\u002Fdiv><\u002Fsc-for>\n      <\u002Fdiv>\n      <div style=\"background:transparent;border:1px dashed #C99700;border-top:3px dotted #C99700;padding:22px;display:flex;flex-direction:column;gap:14px\">\n        <div style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-size:18px;font-weight:600;color:#0C2340\">What We Need to Prove<\u002Fspan><span style=\"padding:2px 8px;border:1px dotted #A87E00;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:#7A5C00\">VALIDATE<\u002Fspan><\u002Fdiv>\n        <span style=\"font-size:13px;color:#202832\">Questions requiring validation.<\u002Fspan>\n        <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 16px\"><sc-for list=\"{{ prove }}\" as=\"p\" hint-placeholder-count=\"10\"><div style=\"display:flex;gap:8px;padding:9px 0;border-top:1px dotted #E0CC8A;font-size:14px;color:#202832\"><span style=\"color:#A87E00;font-weight:600\">?<\u002Fspan><span>{{ p }}<\u002Fspan><\u002Fdiv><\u002Fsc-for><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n\n    <div style=\"display:flex;flex-direction:column;gap:16px;padding-top:12px\">\n      <div style=\"display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap\">\n        <div style=\"display:flex;flex-direction:column;gap:8px\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#707780\">FIRST TWO WEEKS<\u002Fspan><h3 style=\"margin:0;font-size:30px;font-weight:600;color:#0C2340;letter-spacing:-0.01em\">Retire the biggest risks first.<\u002Fh3><\u002Fdiv>\n        <span style=\"font-size:12.5px;color:#707780\">Tap an item to change its status. Mark HIGH IMPACT where the answer could change the direction.<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px\">\n        <sc-for list=\"{{ track }}\" as=\"tc\" hint-placeholder-count=\"3\">\n          <div style=\"background:#FFFFFF;border:1px solid #E9EBED;padding:20px;display:flex;flex-direction:column;gap:8px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;padding-bottom:6px\"><span style=\"font-family:'IBM Plex Mono',mono