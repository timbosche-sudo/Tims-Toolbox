400ms\"><\u002Fpolygon><\u002Fg><\u002Fsc-for><sc-for list=\"{{ labels }}\" as=\"lb\"><text x=\"{{ lb.x }}\" y=\"{{ lb.y }}\" fill=\"{{ lb.c }}\" style=\"font-family:'IBM Plex Mono',monospace;font-size:{{ lb.fs }};letter-spacing:0.08em;text-anchor:middle;font-weight:{{ lb.w }}\">{{ lb.t1 }}<tspan x=\"{{ lb.x }}\" dy=\"11\">{{ lb.t2 }}<\u002Ftspan><\u002Ftext><\u002Fsc-for><\u002Fsvg><\u002Fdiv>\n          <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));border-top:1px solid #E9EBED\">\n            <sc-for list=\"{{ tgR.strat }}\" as=\"s\" hint-placeholder-count=\"5\"><div style=\"padding:14px 18px;border-left:1px solid #F1F2F3;display:flex;flex-direction:column;gap:6px\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.1em;color:#707780\">{{ s.k }}<\u002Fspan><span style=\"font-size:16px;font-weight:600;color:#0C2340\">{{ s.v }}<\u002Fspan><\u002Fdiv><\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:flex;flex-direction:column;gap:12px;min-width:0\">\n          <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px\">\n            <sc-for list=\"{{ tgR.primary }}\" as=\"m\" hint-placeholder-count=\"4\">\n              <div style=\"background:#FFFFFF;border:1px solid #E9EBED;padding:22px;display:flex;flex-direction:column;gap:12px\">\n                <span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.1em;color:#707780\">{{ m.label }}<\u002Fspan>\n                <span style=\"font-size:28px;font-weight:600;color:#0C2340\">{{ m.level }}<\u002Fspan>\n                <span style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:3px\"><sc-for list=\"{{ m.segs }}\" as=\"sv\"><span style=\"height:10px;background:{{ sv }};transition:background 350ms\"><\u002Fspan><\u002Fsc-for><\u002Fspan>\n                <sc-if value=\"{{ m.sens }}\"><span style=\"padding:1px 6px;border:1px dashed #A87E00;font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.08em;color:#7A5C00;white-space:nowrap\">SENSITIVE TO VALIDATION<\u002Fspan><\u002Fsc-if>\n              <\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n          <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px\">\n            <sc-for list=\"{{ tgR.secondary }}\" as=\"m\" hint-placeholder-count=\"2\">\n              <div style=\"padding:14px 18px;border:1px solid #E9EBED;display:flex;flex-direction:column;gap:6px\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:#707780\">{{ m.label }}<\u002Fspan><span style=\"font-size:17px;font-weight:500;color:#202832\">{{ m.level }}<\u002Fspan><span style=\"display:grid;grid-template-columns:repeat(5,1fr);gap:3px\"><sc-for list=\"{{ m.segs }}\" as=\"sv\"><span style=\"height:5px;background:{{ sv }};transition:background 350ms\"><\u002Fspan><\u002Fsc-for><\u002Fspan><\u002Fdiv>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px\">\n        <div style=\"background:#FFFFFF;border-top:4px solid #0C2340;padding:26px;display:flex;flex-direction:column;gap:14px\">\n          <span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;color:#0C2340\">WHAT THIS MEANS<\u002Fspan>\n          <sc-for list=\"{{ tgR.means }}\" as=\"t\" hint-placeholder-count=\"3\"><div style=\"display:grid;grid-template-columns:22px minmax(0,1fr);gap:10px;padding-top:12px;border-top:1px solid #F1F2F3;font-size:17px;line-height:1.45;color:#202832\"><span style=\"width:14px;height:2px;background:#C99700;margin-top:12px\"><\u002Fspan><span style=\"text-wrap:pretty\">{{ t }}<\u002Fspan><\u002Fdiv><\u002Fsc-for>\n        <\u002Fdiv>\n        <div style=\"border:1px dashed #C99700;border-top:4px dotted #C99700;padding:26px;display:flex;flex-direction:column;gap:14px\">\n          <span style=\"display:flex;justify-content:space-between;align-items:center\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.14em;color:#7A5C00\">WHAT WE STILL NEED TO PROVE<\u002Fspan><span style=\"padding:2px 8px;border:1px dotted #A87E00;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:#7A5C00\">VALIDATE<\u002Fspan><\u002Fspan>\n          <sc-for list=\"{{ tgR.prove }}\" as=\"t\" hint-placeholder-count=\"4\"><div style=\"display:grid;grid-template-columns:22px minmax(0,1fr);gap:10px;padding-top:12px;border-top:1px dotted #E0CC8A;font-size:17px;line-height:1.45;color:#202832\"><span style=\"color:#A87E00;font-weight:700\">?<\u002Fspan><span style=\"text-wrap:pretty\">{{ t }}<\u002Fspan><\u002Fdiv><\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap\">\n        <div style=\"display:flex;gap:10px;flex-wrap:wrap\">\n          <button sc-camel-on-click=\"{{ tgSave }}\" style=\"min-height:56px;padding:0 26px;background:{{ tgSaveBg }};color:#FFFFFF;border:none;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.12em;cursor:pointer;transition:background 200ms\">{{ tgSaveLabel }}<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ tgAdjust }}\" style=\"min-height:56px;padding:0 22px;background:transparent;color:#0C2340;border:1px solid #0C2340;font-size:15px;font-weight:500;cursor:pointer\">Adjust answers<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ tgRestart }}\" style=\"min-height:56px;padding:0 18px;background:transparent;color:#707780;border:1px solid #E9EBED;font-size:15px;cursor:pointer\">Start over<\u002Fbutton>\n        <\u002Fdiv>\n        <sc-if value=\"{{ notPres }}\" hint-placeholder-val=\"{{ true }}\"><button sc-camel-on-click=\"{{ tgReturn }}\" style=\"min-height:56px;padding:0 24px;background:transparent;color:#0C2340;border:1px solid #0C2340;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.12em;cursor:pointer\">RETURN TO EXPLORER<\u002Fbutton><\u002Fsc-if>\n      <\u002Fdiv>\n      <span style=\"font-size:12.5px;color:#707780\">Illustrative planning scenario for discussion. It is not a recommendation, and every indicator requires validation.<\u002Fspan>\n    <\u002Fdiv>\n  <\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ vClosing }}\" hint-placeholder-val=\"{{ false }}\">\n<div data-screen-label=\"Closing\" style=\"flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;padding:40px clamp(24px,6vw,96px);text-align:center;background:#F8F7F4\">\n  <span style=\"width:56px;height:2px;background:#C99700\"><\u002Fspan>\n  <p style=\"margin:0;font-size:clamp(34px,4vw,68px);line-height:1.12;letter-spacing:-0.01em;color:#0C2340;max-width:1500px;text-transform:uppercase;text-wrap:balance\"><span style=\"font-weight:300\">The goal isn’t to predict the future.<\u002Fspan><br><span style=\"font-weight:600\">It’s to create a framework capable of responding to it.<\u002Fspan><\u002Fp>\n  <span style=\"font-family:'IBM Plex Mono',monospace;font-size:16px;letter-spacing:0.24em;color:#0C2340\">ALIGN <span style=\"color:#C99700\">→<\u002Fspan> ITERATE <span style=\"color:#C99700\">→<\u002Fspan> REALIZE<\u002Fspan>\n  <span style=\"font-size:15px;letter-spacing:0.04em;color:#707780\"><span style=\"font-weight:700;color:#0C2340\">RAISE ND<\u002Fspan> × BSA LifeStructures<\u002Fspan>\n  <button sc-camel-on-click=\"{{ stopPresent }}\" style=\"margin-top:12px;min-height:48px;padding:0 22px;background:transparent;color:#0C2340;border:1px solid #0C2340;font-size:15px;cursor:pointer\">Return to Explorer<\u002Fbutton>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ presStrip }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"flex:none;height:60px;display:flex;justify-content:space-between;align-items:stretch;gap:16px;padding:0 clamp(16px,3vw,48px);border-top:1px solid #E9EBED;background:#FFFFFF\">\n  <span style=\"display:flex;align-items:center;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:#707780;white-space:nowrap\">RAISE ND<\u002Fspan>\n  <div style=\"display:flex;gap:0;min-width:0;overflow-x:auto\">\n    <sc-for list=\"{{ presNav }}\" as=\"p\" hint-placeholder-count=\"5\"><button sc-camel-on-click=\"{{ p.onClick }}\" style=\"flex:none;padding:0 clamp(10px,1.2vw,20px);background:none;border:none;border-top:2px solid {{ p.bd }};display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.12em;color:{{ p.fg }};white-space:nowrap;cursor:pointer;transition:color 200ms\"><span style=\"color:{{ p.nc }}\">{{ p.num }}<\u002Fspan>{{ p.label }}<\u002Fbutton><\u002Fsc-for>\n  <\u002Fdiv>\n  <button sc-camel-on-click=\"{{ stopPresent }}\" style=\"flex:none;align-self:center;min-height:40px;padding:0 14px;background:none;border:1px solid #E9EBED;color:#707780;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.12em;cursor:pointer\">ESC<\u002Fbutton>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ appFooter }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"flex:none;min-height:36px;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:0 28px;border-top:1px solid #E9EBED;background:#FFFFFF;font-size:12px;color:#707780\">\n  <span style=\"display:flex;gap:8px;align-items:center;white-space:nowrap\"><span style=\"font-weight:700;color:#0C2340\">RAISE ND<\u002Fspan><span>×<\u002Fspan><span style=\"font-weight:600;color:#202832\">BSA LifeStructures<\u002Fspan><\u002Fspan>\n  <span style=\"display:{{ stageDisp }}\">Conceptual decision-support exercise. All values illustrative and subject to validation.<\u002Fspan>\n  <button sc-camel-on-click=\"{{ askReset }}\" style=\"min-height:32px;background:none;border:none;color:#707780;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:0.1em;cursor:pointer;white-space:nowrap\">RESET INTERVIEW DEMO<\u002Fbutton>\n<\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ resetOpen }}\" hint-placeholder-val=\"{{ false }}\">\n<div style=\"position:fixed;inset:0;z-index:60;background:rgba(12,35,64,0.35);display:flex;align-items:center;justify-content:center;padding:24px\">\n  <div style=\"width:min(540px,100%);background:#FFFFFF;padding:30px 32px;display:flex;flex-direction:column;gap:16px;box-shadow:0 24px 60px rgba(12,35,64,0.2)\">\n    <span style=\"font-size:22px;font-weight:600;color:#0C2340\">Reset interview demo?<\u002Fspan>\n    <span style=\"font-size:14px;line-height:1.5;color:#202832\">This restores the three demonstration scenarios, clears Explore Together answers, returns validation statuses and phasing classifications to their starting condition, and returns to the landing page.<\u002Fspan>\n    <div style=\"display:flex;justify-content:flex-end;gap:10px;padding-top:6px\">\n      <button sc-camel-on-click=\"{{ cancelReset }}\" style=\"min-height:48px;padding:0 20px;background:transparent;border:1px solid #C3C6CA;color:#202832;font-size:14px;cursor:pointer\">Cancel<\u002Fbutton>\n      <button sc-camel-on-click=\"{{ doReset }}\" style=\"min-height:48px;padding:0 20px;background:#0C2340;border:none;color:#FFFFFF;font-size:14px;font-weight:600;cursor:pointer\">Reset demo<\u002Fbutton>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fdiv>\n<\u002Fsc-if>\n<\u002Fdiv>\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\">\nclass Component extends DCLogic {\n  static MET = [\n    { k: 'dis', label: 'Research Continuity', inv: true, p: true },\n    { k: 'ada', label: 'Future Adaptability', p: true },\n    { k: 'cap', label: 'Investment Intensity', p: true },\n    { k: 'cpx', label: 'Implementation Complexity', p: true },\n    { k: 'spd', label: 'Speed to Capacity' },\n    { k: 'trn', label: 'Campus Transformation' }\n  ];\n  static DEF_IMPACT = { 'BUILDING:Structure': 1, 'BUILDING:Vibration': 1, 'BUILDING:Mechanical capacity': 1, 'CAMPUS:Utility capacity': 1, 'RESEARCH:Move constraints': 1, 'RESEARCH:Temporary research capacity': 1 };\n  static SEC = ['present', 'together', 'phasing', 'validate', 'roadmap', 'closing'];\n  static TG_EMPTY = { step: 0, pri: [], growth: null, cont: null, prog: null };\n  static TG = {\n    pri: [\n      ['continuity', 'RESEARCH CONTINUITY', 'Protect active research and minimize interruption.'],\n      ['adaptability', 'FUTURE ADAPTABILITY', 'Create environments capable of responding to changing research needs.'],\n      ['stewardship', 'CAPITAL STEWARDSHIP', 'Balance investment with long-term value.'],\n      ['speed', 'SPEED TO CAPACITY', 'Create needed research capacity as quickly as reasonably possible.'],\n      ['transformation', 'CAMPUS TRANSFORMATION', 'Use this investment to meaningfully reshape the science and engineering district.'],\n      ['preservation', 'PRESERVATION', 'Maximize the value of existing facilities and infrastructure.']\n    ],\n    growth: [['MEASURED', 'Respond primarily to committed and near-term needs.'], ['TARGET', 'Plan for the current stated growth trajectory.'], ['EXPANSIVE', 'Create greater capacity for accelerated future growth.']],\n    cont: [['SIMPLIFY IMPLEMENTATION', 'Accept more concentrated transitions to reduce phasing complexity.'], ['BALANCE', 'Balance research continuity, schedule, and implementation complexity.'], ['PROTECT CONTINUITY', 'Prioritize ongoing research even if this increases swing-space and phasing requirements.']],\n    prog: [['BUILD SPACE', 'Provide more dedicated capacity today.'], ['BALANCE', 'Combine dedicated growth space with flexible shared infrastructure.'], ['BUILD ADAPTABILITY', 'Prioritize flexible research neighborhoods, shared resources, modular planning, and infrastructure capacity.']],\n    q: ['What should matter most?', 'How aggressively should Notre Dame plan for growth?', 'How important is protecting active research during implementation?', 'How should Notre Dame prepare for research we cannot yet predict?']\n  };\n  static LV = ['Low', 'Low–Moderate', 'Moderate', 'Moderate–High', 'High'];\n\n  // Developer-editable rule set. fx = additive influence on each qualitative measure (illustrative).\n  static RULES = {\n    itc: { label: 'ITC Strategy', options: [\n      { key: 'reuse', label: 'REUSE', name: 'Reuse', desc: 'Retain existing building with targeted renovation.',\n        fx: { cap: 1, dis: 1.5, cpx: 1, ada: 1, spd: 0, trn: 0.5 },\n        note: { cap: 'Targeted renovation of the existing ITC keeps new construction on the site to a minimum.', dis: 'Renovation work stays within the existing ITC footprint.', cpx: 'Scope is limited to a single existing building.', ada: 'Retaining ITC carries forward its existing structure, floor-to-floor heights and systems.', trn: 'The ITC site stays largely as it is today, leaving its remaining carrying capacity unused for now.' } },\n      { key: 'reuseAdd', label: 'REUSE + ADD', name: 'Reuse + Add', desc: 'Retain existing building and strategically expand.',\n        fx: { cap: 2.5, dis: 2, cpx: 2, ada: 2, spd: -0.3, trn: 2.5 },\n        note: { cap: 'An addition on the ITC site adds new construction alongside renovation of the existing building.', ada: 'New space can be planned around contemporary research modules, while the retained building keeps its constraints.', trn: 'An addition begins to use the ITC site’s ~160,000 GSF carrying capacity and changes its campus presence.', cpx: 'Coordinating an addition with renovation of the existing building adds sequencing steps.', spd: 'Integrating the addition with the existing building adds coordination time.', dis: 'Construction adjacent to the retained building affects its occupants.' } },\n      { key: 'replace', label: 'REPLACE', name: 'Replace', desc: 'Remove the existing building and construct a new facility.',\n        fx: { cap: 4, dis: 2.5, cpx: 2.5, ada: 3.5, spd: -1, trn: 4 },\n        note: { cap: 'Demolition and a full new facility raise first cost on the ITC site.', ada: 'A new building removes inherited constraints and can be planned for future research modes.', trn: 'Replacement lets the ITC site be reconsidered as a prominent address on the research corridor.', dis: 'Existing ITC occupants must relocate before demolition.', spd: 'Demolition and new construction extend the time before the site delivers capacity.', cpx: 'Demolition, relocation and new construction must be sequenced.' } }\n    ] },\n    galvin: { label: 'Galvin Strategy', options: [\n      { key: 'renovate', label: 'RENOVATE', name: 'Renovate', desc: 'Major renovation of existing Galvin.',\n        fx: { cap: 2, dis: 6, cpx: 4, ada: 1, spd: -1.5, trn: 0.5 },\n        note: { dis: 'Major renovation of an occupied research building requires multiple decant and return moves.', cpx: 'Occupied renovation depends on zone-by-zone phasing and swing space.', ada: 'Existing Galvin geometry and infrastructure constrain future research environments.', cap: 'Reusing the structure limits new construction, but renovation premiums and deferred maintenance remain.', spd: 'Phased renovation of 202,800 GSF delivers upgraded capacity gradually.', trn: 'The Galvin complex remains in its current form.' } },\n      { key: 'renovateAdd', label: 'RENOVATE + ADD', name: 'Renovate + Add', desc: 'Retain primary structure with strategic additions.',\n        fx: { cap: 3, dis: 5.5, cpx: 4.5, ada: 2, spd: -1, trn: 2 },\n        note: { dis: 'Additions can host some research during renovation, but most of Galvin is still renovated while occupied.', cpx: 'Additions and renovation must be sequenced together.', ada: 'Additions bring adaptable space; the retained structure keeps its constraints.', cap: 'Additions add new construction on top of a major renovation.', trn: 'Additions give Galvin a new edge while the core remains.', spd: 'An early addition can bring capacity online before renovation is complete.' } },\n      { key: 'hybrid', label: 'HYBRID', name: 'Hybrid', desc: 'Retain selected portions while replacing others.',\n        fx: { cap: 3.5, dis: 4.5, cpx: 5, ada: 3.5, spd: -1.5, trn: 3.5 },\n        note: { dis: 'Replacing selected portions first can create new space for research before other areas are renovated.', cpx: 'Selective retention and replacement require careful definition of what stays and how the parts connect.', ada: 'Replacing the most limiting portions removes the constraints that most affect future research.', cap: 'Partial replacement adds new construction while retaining portions of the existing structure.', trn: 'Partial replacement reshapes part of the Galvin site.', spd: 'Two kinds of work, replacement and renovation, extend the sequence.' } },\n      { key: 'replace', label: 'REPLACE', name: 'Replace', desc: 'Phased replacement of the existing complex.',\n        fx: { cap: 5, dis: 3.5, cpx: 3.5, ada: 4.5, spd: -2.5, trn: 5 },\n        note: { dis: 'Building replacement space first lets research move once rather than decanting and returning.', cpx: 'A phased replacement concentrates complexity in the transition, with a simpler final-state plan.', ada: 'A replacement complex can be planned entirely around adaptable research neighborhoods.', cap: 'Phased replacement of the full complex carries the highest initial capital intensity.', spd: 'New construction must be complete before research can relocate.', trn: 'Replacement allows the Galvin site to be fully reconsidered within the research corridor.' } }\n    ] },\n    growth: { label: 'Growth Assumption', num: '03', options: [\n      { label: 'MODERATE', name: 'Moderate', desc: 'Slower faculty growth, less immediate dedicated research space, greater reliance on flexible and shared infrastructure.', fx: { cap: -0.3, spd: 0.5, ada: 0.3 } },\n      { label: 'TARGET', name: 'Target', desc: 'Reflects the currently stated planning growth trajectory.', fx: { cap: 0.5, cpx: 0.2, trn: 0.3 } },\n      { label: 'HIGH', name: 'Hi