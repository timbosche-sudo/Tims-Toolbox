e=\"stroke-width:1.4;stroke-dasharray:{{ b.da }}\"><\u002Fpolygon><polygon points=\"{{ b.t }}\" fill=\"{{ b.ft }}\" stroke=\"{{ b.st }}\" style=\"stroke-width:1.4;stroke-dasharray:{{ b.da }}\"><\u002Fpolygon><\u002Fg><\u002Fsc-for>\n            <\u002Fsvg>\n          <\u002Fbutton>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n      <sc-for list=\"{{ cmpRows }}\" as=\"r\" hint-placeholder-count=\"10\">\n        <div style=\"display:grid;grid-template-columns:{{ cmpCols }};border-bottom:1px solid {{ r.bb }};min-height:{{ r.mh }}\">\n          <div style=\"padding:10px 20px;display:flex;flex-direction:column;justify-content:center;gap:5px\">\n            <span style=\"font-size:{{ r.fs }};font-weight:{{ r.fw }};color:{{ r.fc }}\">{{ r.label }}<\u002Fspan>\n            <span style=\"display:flex;gap:2px\"><sc-for list=\"{{ r.w }}\" as=\"wv\"><span style=\"width:12px;height:3px;background:{{ wv }}\"><\u002Fspan><\u002Fsc-for><\u002Fspan>\n          <\u002Fdiv>\n          <sc-for list=\"{{ r.cells }}\" as=\"ce\">\n            <div style=\"padding:10px 18px;border-left:1px solid #F1F2F3;display:flex;align-items:center;justify-content:space-between;gap:12px;background:{{ ce.bg }};transition:background 300ms\">\n              <span style=\"display:flex;flex-direction:column;gap:4px\"><span style=\"font-size:{{ ce.fs }};color:{{ ce.fc }};font-weight:{{ ce.fw }}\">{{ ce.text }}<\u002Fspan><sc-if value=\"{{ ce.sens }}\"><span style=\"font-family:'IBM Plex Mono',monospace;font-size:9.5px;letter-spacing:0.08em;color:#7A5C00\">◇ SENSITIVE TO VALIDATION<\u002Fspan><\u002Fsc-if><\u002Fspan>\n              <sc-if value=\"{{ ce.segs }}\"><span style=\"display:grid;grid-template-columns:repeat(5,14px);gap:2px\"><sc-for list=\"{{ ce.segs }}\" as=\"sv\"><span style=\"height:6px;background:{{ sv }}\"><\u002Fspan><\u002Fsc-for><\u002Fspan><\u002Fsc-if>\n            <\u002Fdiv>\n          <\u002Fsc-for>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n      <div style=\"padding:12px 20px;font-siz